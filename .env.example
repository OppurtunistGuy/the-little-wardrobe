# ==============================================================================
# The Little Wardrobe — Environment Configuration
# ==============================================================================

# Supabase Project Connection
# Replace with your production Supabase Project URL and Public Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode Note:
# When these variables are set, the app strictly uses Supabase PostgreSQL and Storage as the single source of truth.
# When omitted, the app operates in offline local preview mode with clear admin notification.
